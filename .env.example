LAB_PORT=8086
LAB_AUTH_MODE=local
LAB_LOCAL_DEVELOPMENT=true
LAB_LOCAL_PASSWORD=CHANGE_ME_USE_AT_LEAST_16_CHARACTERS
LAB_ADMIN_USERS=admin
LAB_NETWORK_NAME=python-lab-rescue-internal
LAB_SINGLEUSER_IMAGE=python-lab-rescue-singleuser:2026-07-28
LAB_USER_VOLUME_PREFIX=python-lab-user
LAB_MEM_LIMIT=1G
LAB_CPU_LIMIT=1.0
LAB_PIDS_LIMIT=256
MOODLE_DOCKER_NETWORK=moodle-rescue-local_local_access
PYTHON_LAB_SUBMIT_ENABLED=false

# Leave these empty for local login. Fill them from the Moodle registration
# output before setting LAB_AUTH_MODE=lti13.
LTI13_ISSUER=
LTI13_CLIENT_ID=
LTI13_AUTHORIZE_URL=
LTI13_JWKS_ENDPOINT=
LTI13_USERNAME_KEY=sub
LTI13_URI_SCHEME=auto
