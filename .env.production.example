LAB_HOST=lab.example.org
TRAEFIK_NETWORK=rescue_proxy

LAB_AUTH_MODE=lti13
LAB_LOCAL_DEVELOPMENT=false
LAB_LOCAL_PASSWORD=NOT_USED_WHILE_LTI13_IS_ENABLED
LAB_ADMIN_USERS=
LAB_NETWORK_NAME=python-lab-rescue-internal
LAB_SINGLEUSER_IMAGE=python-lab-rescue-singleuser:2026-07-28
LAB_USER_VOLUME_PREFIX=python-lab-user
LAB_MEM_LIMIT=1G
LAB_CPU_LIMIT=1.0
LAB_PIDS_LIMIT=256

LTI13_ISSUER=https://learn.example.org
LTI13_CLIENT_ID=REPLACE_WITH_MOODLE_CLIENT_ID
LTI13_AUTHORIZE_URL=https://learn.example.org/mod/lti/auth.php
LTI13_JWKS_ENDPOINT=https://learn.example.org/mod/lti/certs.php
LTI13_USERNAME_KEY=sub
LTI13_URI_SCHEME=https
